# ══════════════════════════════════════════════════════════════════════════════
# LogiFlow — Variables de entorno globales
# Copia a .env y ajusta los valores antes de ejecutar docker-compose
# ══════════════════════════════════════════════════════════════════════════════

# ── JWT (secreto compartido por ms-auth, ms-clientes, ms-pedidos, ms-ruteo) ──
JWT_SECRET=logiflow-secret-key-fase2-must-be-at-least-32-chars

# ── RabbitMQ ──────────────────────────────────────────────────────────────────
RABBITMQ_USERNAME=logiflow
RABBITMQ_PASSWORD=logiflow2026

# ── Bases de datos (contraseña común para todos los MySQL) ────────────────────
DB_PASSWORD=root
